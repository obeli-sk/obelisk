{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppConfigToml",
  "type": "object",
  "properties": {
    "app_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 4,
      "maxLength": 25,
      "pattern": "^[a-z0-9][a-z0-9-]{2,23}[a-z0-9]$",
      "default": null
    },
    "cloud": {
      "$ref": "#/$defs/CloudConfigToml",
      "default": {}
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SecretConfigToml"
      },
      "default": {}
    },
    "public_env": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PublicEnvConfigToml"
      },
      "default": {}
    },
    "allowed_exec_activities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SecretExposureDigests"
      },
      "default": {}
    },
    "outbound_http": {
      "$ref": "#/$defs/OutboundHttpToml",
      "default": {
        "allowed_host": []
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CloudConfigToml": {
      "type": "object",
      "properties": {
        "memory_mb": {
          "description": "VM memory in MB; omission uses the cloud default.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "SecretConfigToml": {
      "description": "Source and exposure authorization for a secret in the `[secrets]` table.",
      "anyOf": [
        {
          "$ref": "#/$defs/EnvSecretConfigToml"
        },
        {
          "$ref": "#/$defs/InternalSecretConfigToml"
        }
      ]
    },
    "EnvSecretConfigToml": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/EnvSecretType",
          "writeOnly": true
        },
        "optional": {
          "description": "Allow the environment source to be absent.",
          "type": "boolean"
        },
        "exposed_to": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SecretExposureDigests"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "EnvSecretType": {
      "type": "string",
      "enum": [
        "env"
      ]
    },
    "SecretExposureDigests": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "InternalSecretConfigToml": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/InternalSecretType"
        },
        "exposed_to": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SecretExposureDigests"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "InternalSecretType": {
      "type": "string",
      "enum": [
        "internal"
      ]
    },
    "PublicEnvConfigToml": {
      "description": "Configuration for one public environment variable.",
      "anyOf": [
        {
          "$ref": "#/$defs/EnvPublicEnvConfigToml"
        },
        {
          "$ref": "#/$defs/InternalPublicEnvConfigToml"
        }
      ]
    },
    "EnvPublicEnvConfigToml": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/EnvSecretType",
          "writeOnly": true
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "InternalPublicEnvConfigToml": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/InternalSecretType"
        },
        "source": {
          "$ref": "#/$defs/InternalPublicEnvSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "source"
      ]
    },
    "InternalPublicEnvSource": {
      "type": "string",
      "enum": [
        "api-url",
        "webui-url"
      ]
    },
    "OutboundHttpToml": {
      "type": "object",
      "properties": {
        "allowed_host": {
          "description": "Global outbound HTTP entries use the same grammar as deployment\n`allowed_host` entries.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AllowedHostToml"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "AllowedHostToml": {
      "description": "An allowed outgoing HTTP host with optional method restrictions and secrets.",
      "type": "object",
      "properties": {
        "pattern": {
          "description": "Host pattern (e.g. `\"api.example.com\"`, `\"*.example.com\"`, `\"http://localhost:8080\"`).",
          "type": "string"
        },
        "methods": {
          "description": "Allowed HTTP methods.\n- Omit to allow nothing (warning emitted).\n- `methods = \"*\"` or `methods = [\"*\"]` to allow all methods.\n- `methods = [\"GET\", \"POST\"]` to allow specific methods.\n- `methods = []` to allow nothing (warning emitted).",
          "anyOf": [
            {
              "$ref": "#/$defs/MethodsInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_url_regex": {
          "description": "Optional regex restriction checked against `METHOD URL` with query params removed.\nFor example, `GET https://api.example.com/v1/items`.\nSupports `${VAR}` and `${VAR:-default}` env var interpolation.\nEnv var values are interpreted as regex syntax; use regex-escaped values when precision matters.\nOmit to allow all paths accepted by the host and method restrictions.",
          "type": [
            "string",
            "null"
          ]
        },
        "secrets": {
          "description": "Registered secret names (from the app-owned `app.toml` `[secrets]`\ntable) to make available for placeholder injection into requests to this host.\nEach name is exposed to the guest as an env var holding a random placeholder,\nswapped for the real value in `replace_in` locations before the request leaves.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretRef"
          },
          "default": []
        },
        "replace_in": {
          "description": "Where in the request to perform placeholder replacement:\n- `headers` searches textual header values, including placeholders within larger values.\n- `params` searches URL query parameter values.\n- `body` searches valid UTF-8 bodies whose content type is text, JSON, or form-urlencoded.\n\nDefault: empty (no replacement, deny by default).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReplaceIn"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern"
      ]
    },
    "MethodsInput": {
      "description": "Input for method restrictions in TOML configuration.\nSupports both `methods = \"*\"` and `methods = [\"GET\", \"POST\"]` syntax.",
      "anyOf": [
        {
          "description": "All methods allowed (from `methods = \"*\"`).",
          "$ref": "#/$defs/MethodsInputStar"
        },
        {
          "description": "Specific methods list (from `methods = [\"GET\", \"POST\"]`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "MethodsInputStar": {
      "type": "null"
    },
    "SecretRef": {
      "description": "A reference to a secret registered in app.toml `[secrets]`.\nEither `\"NAME\"` (required) or `{ name = \"NAME\", optional = true }`.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/SecretRefTableToml"
        }
      ]
    },
    "SecretRefTableToml": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "ReplaceIn": {
      "description": "Where in the outgoing request placeholders are replaced.",
      "type": "string",
      "enum": [
        "headers",
        "body",
        "params"
      ]
    }
  }
}

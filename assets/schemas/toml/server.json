{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerConfigToml",
  "type": "object",
  "properties": {
    "obelisk-version": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "secrets": {
      "description": "Operator-owned secret registry. Maps a logical secret name to a source\n(currently only `{ env = \"VAR\" }`). Env-backed secrets are resolved and\ntheir source variables wiped from the process environment at startup, before\nthe tokio runtime starts. Deployments reference these names in `activity_exec`\n`secrets` and `allowed_host[].secrets`; they cannot interpolate them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SecretSourceToml"
      },
      "default": {}
    },
    "allow_exec_activities": {
      "description": "Permit deployments to run host processes through `activity_exec`.\n`false` denies all (default), `true` allows any, a list of `sha256:...`\ncontent digests allows only the listed exec scripts.",
      "$ref": "#/$defs/AllowExecActivities"
    },
    "outbound_http": {
      "description": "Operator-owned allowlist for component-originated HTTP requests.\nAn empty allowlist denies every outbound request.",
      "$ref": "#/$defs/OutboundHttpToml"
    },
    "max_deployment_file_bytes": {
      "description": "Per-file size limit for deployment-owned blobs attached to a submit request.",
      "$ref": "#/$defs/MaxDeploymentFileBytes"
    },
    "api": {
      "$ref": "#/$defs/ApiConfig"
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfigToml"
    },
    "webui": {
      "$ref": "#/$defs/WebUIConfig"
    },
    "external": {
      "$ref": "#/$defs/ExternalServerConfig"
    },
    "wasm": {
      "$ref": "#/$defs/WasmGlobalConfigToml"
    },
    "workflows": {
      "$ref": "#/$defs/WorkflowsGlobalConfigToml"
    },
    "timers_watcher": {
      "$ref": "#/$defs/TimersWatcherTomlConfig"
    },
    "cancel_watcher": {
      "$ref": "#/$defs/CancelWatcherTomlConfig"
    },
    "otlp": {
      "anyOf": [
        {
          "$ref": "#/$defs/OtlpConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "log": {
      "$ref": "#/$defs/LoggingConfig"
    },
    "http_server": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HttpServer"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SecretSourceToml": {
      "description": "Source of a secret in the `[secrets]` table. Untagged so `{ env = \"VAR\" }`\nparses directly; more variants (`{ file = \"...\" }`, Vault, ...) are added later.",
      "anyOf": [
        {
          "description": "Read the secret from a process environment variable at startup.",
          "type": "object",
          "properties": {
            "env": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "env"
          ]
        }
      ]
    },
    "AllowExecActivities": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "OutboundHttpToml": {
      "type": "object",
      "properties": {
        "allowed_host": {
          "description": "Global outbound HTTP entries use the same grammar as deployment\n`allowed_host` entries.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AllowedHostToml"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "AllowedHostToml": {
      "description": "An allowed outgoing HTTP host with optional method restrictions and secrets.",
      "type": "object",
      "properties": {
        "pattern": {
          "description": "Host pattern (e.g. `\"api.example.com\"`, `\"*.example.com\"`, `\"http://localhost:8080\"`).",
          "type": "string"
        },
        "methods": {
          "description": "Allowed HTTP methods.\n- Omit to allow nothing (warning emitted).\n- `methods = \"*\"` or `methods = [\"*\"]` to allow all methods.\n- `methods = [\"GET\", \"POST\"]` to allow specific methods.\n- `methods = []` to allow nothing (warning emitted).",
          "anyOf": [
            {
              "$ref": "#/$defs/MethodsInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_url_regex": {
          "description": "Optional regex restriction checked against `METHOD URL` with query params removed.\nFor example, `GET https://api.example.com/v1/items`.\nSupports `${VAR}` and `${VAR:-default}` env var interpolation.\nEnv var values are interpreted as regex syntax; use regex-escaped values when precision matters.\nOmit to allow all paths accepted by the host and method restrictions.",
          "type": [
            "string",
            "null"
          ]
        },
        "secrets": {
          "description": "Registered secret names (from the operator-owned `server.toml` `[secrets]`\ntable) to make available for placeholder injection into requests to this host.\nEach name is exposed to the guest as an env var holding a random placeholder,\nswapped for the real value in `replace_in` locations before the request leaves.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "replace_in": {
          "description": "Where in the request to perform placeholder replacement:\n- `headers` searches textual header values, including placeholders within larger values.\n- `params` searches URL query parameter values.\n- `body` searches valid UTF-8 bodies whose content type is text, JSON, or form-urlencoded.\n\nDefault: empty (no replacement, deny by default).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReplaceIn"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern"
      ]
    },
    "MethodsInput": {
      "description": "Input for method restrictions in TOML configuration.\nSupports both `methods = \"*\"` and `methods = [\"GET\", \"POST\"]` syntax.",
      "anyOf": [
        {
          "description": "All methods allowed (from `methods = \"*\"`).",
          "$ref": "#/$defs/MethodsInputStar"
        },
        {
          "description": "Specific methods list (from `methods = [\"GET\", \"POST\"]`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "MethodsInputStar": {
      "type": "null"
    },
    "ReplaceIn": {
      "description": "Where in the outgoing request placeholders are replaced.",
      "type": "string",
      "enum": [
        "headers",
        "body",
        "params"
      ]
    },
    "MaxDeploymentFileBytes": {
      "description": "Per-file size limit (in bytes) for deployment-owned blobs, defaulting to 20 MiB.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ApiConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "listening_addr": {
          "type": "string",
          "default": "127.0.0.1:5005"
        },
        "token_hashes": {
          "description": "Accepted API bearer tokens as `sha256:<hex>` digests of the token text.\nHashes are not secrets, so this file stays safe to commit.\nGenerate an entry with `obelisk generate token`.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "token": {
          "description": "Plaintext accepted token, intended for env injection only\n(`OBELISK__API__TOKEN`); do not write it into the config file.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "DatabaseConfigToml": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sqlite": {
              "$ref": "#/$defs/SqliteConfigToml"
            }
          },
          "required": [
            "sqlite"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "postgres": {
              "$ref": "#/$defs/PostgresConfigToml"
            }
          },
          "required": [
            "postgres"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SqliteConfigToml": {
      "type": "object",
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "queue_capacity": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 100
        },
        "pragma": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "metrics_threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurationConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "DurationConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "milliseconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "milliseconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "minutes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "minutes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hours": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "hours"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PostgresConfigToml": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "db_name": {
          "type": "string"
        },
        "subscription_interruption": {
          "description": "Interrupts listening for notifications periodically, needed for Postgres with a local-only subscription mechanism.",
          "$ref": "#/$defs/DurationConfigOptional",
          "default": {
            "seconds": 1
          }
        },
        "provision_policy": {
          "$ref": "#/$defs/PostgresProvisionPolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "user",
        "password",
        "db_name"
      ]
    },
    "DurationConfigOptional": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "type": "object",
          "properties": {
            "milliseconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "milliseconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "minutes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "minutes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hours": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "hours"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PostgresProvisionPolicy": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "never"
          ]
        },
        {
          "description": "Create database if it does not exist.",
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "WebUIConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "listening_addr": {
          "type": "string",
          "default": "127.0.0.1:8080"
        }
      },
      "additionalProperties": false
    },
    "ExternalServerConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "listening_addr": {
          "type": "string",
          "default": "127.0.0.1:9090"
        }
      },
      "additionalProperties": false
    },
    "WasmGlobalConfigToml": {
      "type": "object",
      "properties": {
        "codegen_cache": {
          "$ref": "#/$defs/CodegenCache"
        },
        "cache_directory": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "allocator_config": {
          "$ref": "#/$defs/WasmtimeAllocatorConfig"
        },
        "global_executor_instance_limiter": {
          "$ref": "#/$defs/InflightSemaphore",
          "default": "unlimited"
        },
        "global_webhook_instance_limiter": {
          "$ref": "#/$defs/InflightSemaphore",
          "default": "unlimited"
        },
        "fuel": {
          "$ref": "#/$defs/ValueOrUnlimited"
        },
        "build_semaphore": {
          "$ref": "#/$defs/ValueOrUnlimited"
        },
        "parallel_compilation": {
          "type": "boolean",
          "default": true
        },
        "wasmtime_pooling_config": {
          "$ref": "#/$defs/WasmtimePoolingAllocatorConfig"
        },
        "debug": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "CodegenCache": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "WasmtimeAllocatorConfig": {
      "type": "string",
      "enum": [
        "auto",
        "on_demand",
        "pooling"
      ]
    },
    "InflightSemaphore": {
      "anyOf": [
        {
          "$ref": "#/$defs/Unlimited"
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      ]
    },
    "Unlimited": {
      "type": "string",
      "enum": [
        "unlimited"
      ]
    },
    "ValueOrUnlimited": {
      "anyOf": [
        {
          "$ref": "#/$defs/Unlimited"
        },
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      ]
    },
    "WasmtimePoolingAllocatorConfig": {
      "type": "object",
      "properties": {
        "pooling_memory_keep_resident": {
          "description": "How many bytes to keep resident between instantiations for the\npooling allocator in linear memories.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "pooling_table_keep_resident": {
          "description": "How many bytes to keep resident between instantiations for the\npooling allocator in tables.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "memory_protection_keys": {
          "description": "Enable memory protection keys for the pooling allocator; this can\noptimize the size of memory slots.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "pooling_total_core_instances": {
          "description": "The maximum number of WebAssembly instances which can be created\nwith the pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_total_component_instances": {
          "description": "The maximum number of WebAssembly components which can be created\nwith the pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_total_memories": {
          "description": "The maximum number of WebAssembly memories which can be created with\nthe pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_total_tables": {
          "description": "The maximum number of WebAssembly tables which can be created with\nthe pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_total_stacks": {
          "description": "The maximum number of WebAssembly stacks which can be created with\nthe pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_max_memory_size": {
          "description": "The maximum runtime size of each linear memory in the pooling\nallocator, in bytes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false
    },
    "WorkflowsGlobalConfigToml": {
      "type": "object",
      "properties": {
        "lock_extension_leeway": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "milliseconds": 100
          }
        }
      },
      "additionalProperties": false
    },
    "TimersWatcherTomlConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "leeway": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "milliseconds": 500
          }
        },
        "tick_sleep": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "milliseconds": 100
          }
        }
      },
      "additionalProperties": false
    },
    "CancelWatcherTomlConfig": {
      "type": "object",
      "properties": {
        "tick_sleep": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "seconds": 1
          }
        }
      },
      "additionalProperties": false
    },
    "OtlpConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/EnvFilter"
        },
        "service_name": {
          "type": "string",
          "default": "obelisk-server"
        },
        "otlp_endpoint": {
          "type": "string",
          "default": "http://localhost:4317"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "EnvFilter": {
      "type": "string"
    },
    "LoggingConfig": {
      "type": "object",
      "properties": {
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppenderRollingFile"
            },
            {
              "type": "null"
            }
          ]
        },
        "console": {
          "$ref": "#/$defs/AppenderConsole"
        }
      },
      "additionalProperties": false
    },
    "AppenderRollingFile": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/EnvFilter"
        },
        "span": {
          "$ref": "#/$defs/SpanConfig"
        },
        "target": {
          "type": "boolean",
          "default": false
        },
        "directory": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "rotation": {
          "$ref": "#/$defs/Rotation"
        },
        "style": {
          "$ref": "#/$defs/LoggingStyle"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "directory",
        "prefix"
      ]
    },
    "SpanConfig": {
      "oneOf": [
        {
          "description": "spans are ignored (this is the default)",
          "type": "string",
          "const": "none"
        },
        {
          "description": "one event when span is created",
          "type": "string",
          "const": "new"
        },
        {
          "description": "one event per enter of a span",
          "type": "string",
          "const": "enter"
        },
        {
          "description": "one event per exit of a span",
          "type": "string",
          "const": "exit"
        },
        {
          "description": "one event when the span is dropped",
          "type": "string",
          "const": "close"
        },
        {
          "description": "one event per enter/exit of a span",
          "type": "string",
          "const": "active"
        },
        {
          "description": "events at all points (new, enter, exit, drop)",
          "type": "string",
          "const": "full"
        }
      ]
    },
    "Rotation": {
      "type": "string",
      "enum": [
        "minutely",
        "hourly",
        "daily",
        "never"
      ]
    },
    "LoggingStyle": {
      "type": "string",
      "enum": [
        "plain",
        "plain_compact",
        "json"
      ]
    },
    "AppenderConsole": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "level": {
          "$ref": "#/$defs/EnvFilter"
        },
        "span": {
          "$ref": "#/$defs/SpanConfig"
        },
        "target": {
          "type": "boolean",
          "default": false
        },
        "style": {
          "$ref": "#/$defs/LoggingStyle"
        },
        "writer": {
          "$ref": "#/$defs/AppenderConsoleWriter"
        }
      },
      "additionalProperties": false
    },
    "AppenderConsoleWriter": {
      "type": "string",
      "enum": [
        "Stderr",
        "Stdout"
      ]
    },
    "HttpServer": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/ConfigName"
        },
        "listening_addr": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "listening_addr"
      ]
    },
    "ConfigName": {
      "description": "Activity, Webhook, Workflow or a Http server",
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerConfigToml",
  "type": "object",
  "properties": {
    "app_env_prefix": {
      "description": "Prefix for app-owned environment sources; server environment stays unprefixed.",
      "type": "string",
      "default": ""
    },
    "obelisk-version": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "allowed_exec_activities": {
      "description": "Platform exec gate: `false` (default), `\"*\"`, or a reviewed component/digest set.",
      "$ref": "#/$defs/PlatformExecActivities"
    },
    "limits": {
      "$ref": "#/$defs/LimitsToml"
    },
    "api": {
      "$ref": "#/$defs/ApiConfig"
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfigToml"
    },
    "webui": {
      "$ref": "#/$defs/WebUIConfig"
    },
    "external": {
      "$ref": "#/$defs/ExternalServerConfig"
    },
    "wasm": {
      "$ref": "#/$defs/WasmGlobalConfigToml"
    },
    "v8": {
      "$ref": "#/$defs/V8ConfigToml"
    },
    "webhooks": {
      "$ref": "#/$defs/WebhooksGlobalConfigToml"
    },
    "outbound_http_pool": {
      "$ref": "#/$defs/OutboundHttpPoolToml"
    },
    "workflows": {
      "$ref": "#/$defs/WorkflowsGlobalConfigToml"
    },
    "timers_watcher": {
      "$ref": "#/$defs/TimersWatcherTomlConfig"
    },
    "cancel_watcher": {
      "$ref": "#/$defs/CancelWatcherTomlConfig"
    },
    "maintenance": {
      "$ref": "#/$defs/MaintenanceTomlConfig"
    },
    "otlp": {
      "anyOf": [
        {
          "$ref": "#/$defs/OtlpConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "log": {
      "$ref": "#/$defs/LoggingConfig"
    },
    "http_server": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HttpServer"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PlatformExecActivities": {
      "oneOf": [
        {
          "const": false
        },
        {
          "const": "*"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SecretExposureDigests"
          }
        }
      ]
    },
    "SecretExposureDigests": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "LimitsToml": {
      "type": "object",
      "properties": {
        "max_persisted_value_size_bytes": {
          "description": "Maximum compact JSON-encoded size of one newly persisted execution\nvalue. Each execution snapshots the effective positive value so config\nchanges do not alter replay. Historical executions created before this\nsetting was persisted retain their legacy unlimited contract.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 1048576
        },
        "max_deployment_file_bytes": {
          "description": "Per-file size limit for deployment-owned blobs attached to a submit request.",
          "$ref": "#/$defs/MaxDeploymentFileBytes"
        },
        "max_transport_message_size_bytes": {
          "description": "Maximum size of a single API request body. Must be positive; the\ndefault is 512 MiB. This is a transport bound and is distinct from\n`max_persisted_value_size_bytes`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 536870912
        },
        "activities": {
          "description": "Concurrency and per-slot memory of the activity runtimes.",
          "$ref": "#/$defs/ActivityCellsToml"
        },
        "workflows": {
          "description": "Concurrency and per-slot memory of the workflow runtimes.",
          "$ref": "#/$defs/WorkflowCellsToml"
        },
        "webhooks": {
          "description": "Concurrency and per-slot memory of the webhook runtimes.",
          "$ref": "#/$defs/WebhookCellsToml"
        }
      },
      "additionalProperties": false
    },
    "MaxDeploymentFileBytes": {
      "description": "Per-file size limit (in bytes) for deployment-owned blobs, defaulting to 20 MiB.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ActivityCellsToml": {
      "description": "The activity runtimes are four different resources: a wasmtime instance, a V8 isolate with its\nown heap and thread, an external process, and an emulated machine. A VM storm must not crowd\nout plain exec activities, so each gets its own reservation. A VM cell is keyed by backend\nbecause the backend decides what a slot costs.",
      "type": "object",
      "properties": {
        "wasm": {
          "description": "Activities running as WASM components, including Boa JavaScript activities.",
          "$ref": "#/$defs/CellToml"
        },
        "v8": {
          "description": "Activities running on native V8.",
          "$ref": "#/$defs/CellToml"
        },
        "process": {
          "description": "`activity_exec` activities, each slot an operating system process.",
          "$ref": "#/$defs/ProcessCellToml"
        },
        "vm_bochs": {
          "description": "`activity_vm` activities on the Bochs backend.",
          "$ref": "#/$defs/CellToml"
        }
      },
      "additionalProperties": false
    },
    "CellToml": {
      "description": "One `(workload, runtime)` cell: how many execution slots it grants and how large one slot may\nget. Both keys accept `\"unlimited\"`; an omitted key takes the cell's default.",
      "type": "object",
      "properties": {
        "count": {
          "anyOf": [
            {
              "$ref": "#/$defs/InflightSemaphore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueOrUnlimited"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "InflightSemaphore": {
      "anyOf": [
        {
          "$ref": "#/$defs/Unlimited"
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      ]
    },
    "Unlimited": {
      "type": "string",
      "enum": [
        "unlimited"
      ]
    },
    "ValueOrUnlimited": {
      "anyOf": [
        {
          "$ref": "#/$defs/Unlimited"
        },
        {
          "$ref": "#/$defs/ByteSizeConfig"
        }
      ]
    },
    "ByteSizeConfig": {
      "description": "A byte size whose unit is part of the key, like [`DurationConfig`]. Units are binary and a\nbare integer is not accepted, so a configuration cannot silently mean something 1024x off.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kib": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kib"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mib": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "mib"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gib": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "gib"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProcessCellToml": {
      "description": "A cell whose slot is an operating system process, so its memory is not wasmtime's business.",
      "type": "object",
      "properties": {
        "count": {
          "anyOf": [
            {
              "$ref": "#/$defs/InflightSemaphore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "WorkflowCellsToml": {
      "type": "object",
      "properties": {
        "wasm": {
          "description": "Workflows running as WASM components, including Boa JavaScript workflows.",
          "$ref": "#/$defs/CellToml"
        },
        "v8": {
          "description": "Workflows running on native V8.",
          "$ref": "#/$defs/CellToml"
        }
      },
      "additionalProperties": false
    },
    "WebhookCellsToml": {
      "type": "object",
      "properties": {
        "wasm": {
          "description": "Webhook endpoints running as WASM components, including Boa JavaScript endpoints.",
          "$ref": "#/$defs/CellToml"
        },
        "v8": {
          "description": "Webhook endpoints running on native V8.",
          "$ref": "#/$defs/CellToml"
        }
      },
      "additionalProperties": false
    },
    "ApiConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "listening_addr": {
          "type": "string",
          "default": "127.0.0.1:5005"
        },
        "token_hashes": {
          "description": "Accepted API bearer tokens as `sha256:<hex>` digests of the token text.\nOnly hashes of high-entropy random tokens are safe to commit: SHA-256 is fast and unsalted,\nso hashes of passwords or other guessable tokens are vulnerable to offline guessing.\nTokens should contain at least 32 characters. Always generate an entry with\n`obelisk generate token`.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "oidc": {
          "description": "Trusted OIDC issuers whose ID tokens are accepted as API bearer tokens.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OidcProviderConfig"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "OidcProviderConfig": {
      "description": "An OIDC issuer whose signed ID tokens (JWTs) must match audience and claim constraints.",
      "type": "object",
      "properties": {
        "issuer": {
          "description": "Exact `iss` value, also the base URL for OIDC discovery. Must be `https://` unless the host is loopback.",
          "type": "string"
        },
        "audience": {
          "description": "Required `aud` value, the audience clients request when minting the token.",
          "type": "string"
        },
        "claims": {
          "description": "Claims that must be present as strings with exactly these values, e.g. `{ app_name = \"deployer\" }`.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "issuer",
        "audience",
        "claims"
      ]
    },
    "DatabaseConfigToml": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "sqlite": {
              "$ref": "#/$defs/SqliteConfigToml"
            }
          },
          "required": [
            "sqlite"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "postgres": {
              "$ref": "#/$defs/PostgresConfigToml"
            }
          },
          "required": [
            "postgres"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SqliteConfigToml": {
      "type": "object",
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "queue_capacity": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 100
        },
        "pragma": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "metrics_threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurationConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "DurationConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "milliseconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "milliseconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "minutes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "minutes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hours": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "hours"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PostgresConfigToml": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "db_name": {
          "type": "string"
        },
        "subscription_interruption": {
          "description": "Interrupts listening for notifications periodically, needed for Postgres with a local-only subscription mechanism.",
          "$ref": "#/$defs/DurationConfigOptional",
          "default": {
            "seconds": 1
          }
        },
        "provision_policy": {
          "$ref": "#/$defs/PostgresProvisionPolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "user",
        "password",
        "db_name"
      ]
    },
    "DurationConfigOptional": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "type": "object",
          "properties": {
            "milliseconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "milliseconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "minutes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "minutes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hours": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "hours"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PostgresProvisionPolicy": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "never"
          ]
        },
        {
          "description": "Create database if it does not exist.",
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "WebUIConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "listening_addr": {
          "type": "string",
          "default": "127.0.0.1:8080"
        },
        "public_url": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ExternalServerConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "listening_addr": {
          "type": "string",
          "default": "127.0.0.1:9090"
        }
      },
      "additionalProperties": false
    },
    "WasmGlobalConfigToml": {
      "type": "object",
      "properties": {
        "codegen_cache": {
          "$ref": "#/$defs/CodegenCache"
        },
        "cache_directory": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "cache_max_size": {
          "description": "Soft artifact cache size limit; files used by the active deployment are never evicted.",
          "$ref": "#/$defs/ByteSizeConfig",
          "default": {
            "mib": 256
          }
        },
        "allocator_config": {
          "$ref": "#/$defs/WasmtimeAllocatorConfig"
        },
        "fuel": {
          "$ref": "#/$defs/ValueOrUnlimited2"
        },
        "build_semaphore": {
          "$ref": "#/$defs/ValueOrUnlimited2"
        },
        "parallel_compilation": {
          "type": "boolean",
          "default": true
        },
        "wasmtime_pooling_config": {
          "$ref": "#/$defs/WasmtimePoolingAllocatorConfig"
        },
        "debug": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "CodegenCache": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "max_size": {
          "description": "Soft size limit excluding metadata; Wasmtime evicts LRU entries on cache writes at most hourly.",
          "$ref": "#/$defs/ByteSizeConfig",
          "default": {
            "mib": 256
          }
        }
      },
      "additionalProperties": false
    },
    "WasmtimeAllocatorConfig": {
      "type": "string",
      "enum": [
        "auto",
        "on_demand",
        "pooling"
      ]
    },
    "ValueOrUnlimited2": {
      "anyOf": [
        {
          "$ref": "#/$defs/Unlimited"
        },
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      ]
    },
    "WasmtimePoolingAllocatorConfig": {
      "type": "object",
      "properties": {
        "pooling_memory_keep_resident": {
          "description": "How many bytes to keep resident between instantiations for the\npooling allocator in linear memories.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "pooling_table_keep_resident": {
          "description": "How many bytes to keep resident between instantiations for the\npooling allocator in tables.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "memory_protection_keys": {
          "description": "Enable memory protection keys for the pooling allocator; this can\noptimize the size of memory slots.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "pooling_total_core_instances": {
          "description": "The maximum number of WebAssembly instances which can be created\nwith the pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_total_component_instances": {
          "description": "The maximum number of WebAssembly components which can be created\nwith the pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_total_memories": {
          "description": "The maximum number of WebAssembly memories which can be created with\nthe pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_total_tables": {
          "description": "The maximum number of WebAssembly tables which can be created with\nthe pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_total_stacks": {
          "description": "The maximum number of WebAssembly stacks which can be created with\nthe pooling allocator.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "pooling_max_memory_size": {
          "description": "The maximum runtime size of each linear memory in the pooling\nallocator, in bytes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false
    },
    "V8ConfigToml": {
      "type": "object",
      "properties": {
        "thread_stack_size": {
          "description": "Stack size for each native V8 isolate thread. How many isolates there may be and how large\none isolate's heap may get are the `v8` cells of `[limits]`.",
          "$ref": "#/$defs/ByteSizeConfig",
          "default": {
            "mib": 4
          }
        }
      },
      "additionalProperties": false
    },
    "WebhooksGlobalConfigToml": {
      "type": "object",
      "properties": {
        "request_timeout": {
          "description": "Wall-clock deadline for a webhook handler to accept the request and return its HTTP\nresponse, regardless of component runtime. Once the response has been returned, this\ndeadline does not limit the lifetime of a streaming response body.",
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "seconds": 30
          }
        },
        "persist_on_outbound_http": {
          "description": "Persist a webhook execution once it sends an outbound HTTP request, keeping its HTTP\nclient traces. Costs a database write per such request. Executions that schedule or call\nother executions, or store logs, are persisted regardless.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "OutboundHttpPoolToml": {
      "description": "Reuse of idle outbound HTTP/1 connections made by activities and webhooks.",
      "type": "object",
      "properties": {
        "max_idle_per_host": {
          "description": "Idle connections kept per scheme, host and port. `0` opens a new connection per request.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 16
        },
        "idle_timeout": {
          "description": "How long an idle connection is kept when the server sends no `Keep-Alive: timeout` hint.\nA hint is honored minus one second, up to 10 minutes.",
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "seconds": 4
          }
        }
      },
      "additionalProperties": false
    },
    "WorkflowsGlobalConfigToml": {
      "type": "object",
      "properties": {
        "max_replay_captured_writes": {
          "description": "Maximum number of captured writes a single replay pass returns. On reaching it, replay\nstops and returns that many writes as an advanceable prefix; advancing them and replaying\nagain resumes from the persisted tip. Keeps a non-terminating workflow (e.g. an unresolved\n`joinNextTry` poll loop, whose replay never blocks) advanceable in bounded batches instead\nof collecting captured writes forever.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 100
        },
        "max_events_per_run": {
          "description": "Maximum number of history events a real workflow run may write before yielding.",
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "default": 100
        },
        "response_refresh_interval": {
          "description": "Number of newly written non-blocking events between database response refreshes.",
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "default": 32
        }
      },
      "additionalProperties": false
    },
    "TimersWatcherTomlConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "leeway": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "milliseconds": 500
          }
        },
        "tick_sleep": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "milliseconds": 100
          }
        }
      },
      "additionalProperties": false
    },
    "CancelWatcherTomlConfig": {
      "type": "object",
      "properties": {
        "tick_sleep": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "seconds": 1
          }
        }
      },
      "additionalProperties": false
    },
    "MaintenanceTomlConfig": {
      "type": "object",
      "properties": {
        "gc": {
          "$ref": "#/$defs/GarbageCollectionTomlConfig",
          "default": {
            "enabled": true,
            "interval": {
              "seconds": 30
            },
            "batch_size": 1000,
            "batch_delay": {
              "milliseconds": 25
            },
            "upload_grace_period": {
              "hours": 1
            },
            "retention": {
              "executions": {
                "enabled": true,
                "max_age": {
                  "hours": 744
                },
                "max_count": 1000
              },
              "deployments": {
                "enabled": true,
                "max_age": {
                  "hours": 744
                },
                "max_count": 100
              },
              "system_events": {
                "enabled": true,
                "max_age": {
                  "hours": 744
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "GarbageCollectionTomlConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interval": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "seconds": 30
          }
        },
        "batch_size": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1000
        },
        "batch_delay": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "milliseconds": 25
          }
        },
        "upload_grace_period": {
          "description": "How long an uploaded deployment file is kept while no deployment references it yet.",
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "hours": 1
          }
        },
        "retention": {
          "$ref": "#/$defs/RetentionTomlConfig",
          "default": {
            "executions": {
              "enabled": true,
              "max_age": {
                "hours": 744
              },
              "max_count": 1000
            },
            "deployments": {
              "enabled": true,
              "max_age": {
                "hours": 744
              },
              "max_count": 100
            },
            "system_events": {
              "enabled": true,
              "max_age": {
                "hours": 744
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "RetentionTomlConfig": {
      "type": "object",
      "properties": {
        "executions": {
          "$ref": "#/$defs/ExecutionRetentionTomlConfig",
          "default": {
            "enabled": true,
            "max_age": {
              "hours": 744
            },
            "max_count": 1000
          }
        },
        "deployments": {
          "$ref": "#/$defs/DeploymentRetentionTomlConfig",
          "default": {
            "enabled": true,
            "max_age": {
              "hours": 744
            },
            "max_count": 100
          }
        },
        "system_events": {
          "$ref": "#/$defs/RetentionPolicyTomlConfig",
          "default": {
            "enabled": true,
            "max_age": {
              "hours": 744
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ExecutionRetentionTomlConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "max_age": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "hours": 744
          }
        },
        "max_count": {
          "description": "Keep at most this many newest finished top-level executions; 0 disables the limit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1000
        }
      },
      "additionalProperties": false
    },
    "DeploymentRetentionTomlConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "max_age": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "hours": 744
          }
        },
        "max_count": {
          "description": "Keep at most this many newest inactive deployments; 0 disables the limit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 100
        }
      },
      "additionalProperties": false
    },
    "RetentionPolicyTomlConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "max_age": {
          "$ref": "#/$defs/DurationConfig",
          "default": {
            "hours": 744
          }
        }
      },
      "additionalProperties": false
    },
    "OtlpConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/EnvFilter"
        },
        "service_name": {
          "type": "string",
          "default": "obelisk-server"
        },
        "otlp_endpoint": {
          "type": "string",
          "default": "http://localhost:4317"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "EnvFilter": {
      "type": "string"
    },
    "LoggingConfig": {
      "type": "object",
      "properties": {
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppenderRollingFile"
            },
            {
              "type": "null"
            }
          ]
        },
        "console": {
          "$ref": "#/$defs/AppenderConsole"
        }
      },
      "additionalProperties": false
    },
    "AppenderRollingFile": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/EnvFilter"
        },
        "span": {
          "$ref": "#/$defs/SpanConfig"
        },
        "target": {
          "type": "boolean",
          "default": false
        },
        "directory": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "rotation": {
          "$ref": "#/$defs/Rotation"
        },
        "style": {
          "$ref": "#/$defs/LoggingStyle"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "directory",
        "prefix"
      ]
    },
    "SpanConfig": {
      "oneOf": [
        {
          "description": "spans are ignored (this is the default)",
          "type": "string",
          "const": "none"
        },
        {
          "description": "one event when span is created",
          "type": "string",
          "const": "new"
        },
        {
          "description": "one event per enter of a span",
          "type": "string",
          "const": "enter"
        },
        {
          "description": "one event per exit of a span",
          "type": "string",
          "const": "exit"
        },
        {
          "description": "one event when the span is dropped",
          "type": "string",
          "const": "close"
        },
        {
          "description": "one event per enter/exit of a span",
          "type": "string",
          "const": "active"
        },
        {
          "description": "events at all points (new, enter, exit, drop)",
          "type": "string",
          "const": "full"
        }
      ]
    },
    "Rotation": {
      "type": "string",
      "enum": [
        "minutely",
        "hourly",
        "daily",
        "never"
      ]
    },
    "LoggingStyle": {
      "type": "string",
      "enum": [
        "plain",
        "plain_compact",
        "json"
      ]
    },
    "AppenderConsole": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "level": {
          "$ref": "#/$defs/EnvFilter"
        },
        "span": {
          "$ref": "#/$defs/SpanConfig"
        },
        "target": {
          "type": "boolean",
          "default": false
        },
        "style": {
          "$ref": "#/$defs/LoggingStyle"
        },
        "writer": {
          "$ref": "#/$defs/AppenderConsoleWriter"
        }
      },
      "additionalProperties": false
    },
    "AppenderConsoleWriter": {
      "type": "string",
      "enum": [
        "Stderr",
        "Stdout"
      ]
    },
    "HttpServer": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/ConfigName"
        },
        "listening_addr": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "listening_addr"
      ]
    },
    "ConfigName": {
      "description": "Activity, Webhook, Workflow or a Http server",
      "type": "string"
    }
  }
}
